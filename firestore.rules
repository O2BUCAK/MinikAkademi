rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Deny Catch-All (Default-Deny Fortress Pattern)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions for Attribute-Based Access Control and Zero-Trust validation
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Schema and boundary validation for User records
    function isValidUser(data) {
      return data.displayName is string 
        && data.displayName.size() > 0 
        && data.displayName.size() <= 100
        && data.xp is number 
        && data.xp >= 0 
        && data.xp <= 5000000
        && data.lang is string 
        && (data.lang == 'tr' || data.lang == 'en')
        && data.createdAt is string 
        && data.createdAt.size() <= 40
        && data.lastActive is string 
        && data.lastActive.size() <= 40
        && (!('email' in data) || (data.email is string && data.email.size() <= 150))
        && (!('playtimeLimit' in data) || (data.playtimeLimit is number && data.playtimeLimit >= 0 && data.playtimeLimit <= 300))
        && (!('parentPasscodeHash' in data) || (data.parentPasscodeHash is string && data.parentPasscodeHash.size() <= 128))
        && (!('parentPasscodeSalt' in data) || (data.parentPasscodeSalt is string && data.parentPasscodeSalt.size() <= 64))
        && (!('parentPasscode' in data) || (data.parentPasscode is string && data.parentPasscode.size() <= 64));
    }

    // Strict validation for new document creation
    function isValidUserCreate(data) {
      return isValidUser(data)
        && data.keys().hasAll(['displayName', 'xp', 'createdAt', 'lastActive', 'lang']);
    }

    // Strict validation for document updates (blocks field tampering and preserves immutable fields)
    function isValidUserUpdate() {
      return isValidUser(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'email', 'xp', 'parentPasscodeHash', 'parentPasscodeSalt', 
          'parentPasscode', 'playtimeLimit', 'lastActive', 'lang'
        ]);
    }

    // Row-level secured user accounts
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // Block user enumeration / list scraping
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserCreate(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserUpdate();
      allow delete: if isOwner(userId) && isValidId(userId);
    }
  }
}
